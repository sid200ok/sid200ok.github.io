# .env.example — SAFE TEMPLATE, NO REAL SECRETS.
# Every value is a REPLACE_ME placeholder on purpose; the `stopwords` list in
# .gitleaks.toml mutes exactly these tokens, so this file is scanned without
# false positives — unlike allowlisting the path, which would blind the scanner
# to the real .env.
#
# Secrets reach tools via FILES (~/.supabase/access-token), never argv, so they
# never land in shell logs.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_ME.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME_anon_publishable_key
# SERVER-SIDE ONLY. Must never appear in a bundle, in dist/, or in any *_PUBLIC var.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_service_role_secret_key
SUPABASE_DB_PASSWORD=REPLACE_ME
DATABASE_URL=postgresql://postgres.REPLACE_ME:REPLACE_ME@aws-0-region.pooler.supabase.com:5432/postgres

# --- LLM providers ---
OPENAI_API_KEY=REPLACE_ME
ANTHROPIC_API_KEY=REPLACE_ME
NVIDIA_NIM_API_KEY=REPLACE_ME

# --- Cloudflare ---
CF_TUNNEL_TOKEN=REPLACE_ME
CLOUDFLARE_API_TOKEN=REPLACE_ME

# --- Runtime ---
# Prefer dynamic/free port allocation: leave PORT unset, let the runtime bind an
# ephemeral port, then read it back from the log/socket.
PORT=
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info
TZ=Asia/Kolkata

# --- Tooling pins ---
GITLEAKS_PIN=
SUPABASE_CLI_VERSION=3.1.0
