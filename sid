#!/usr/bin/env bash
# sid - 100% Safe local dev server (NO systemd, isolated to its own PID only)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PID_FILE="$SCRIPT_DIR/.sid.pid"
PORT_FILE="$SCRIPT_DIR/.sid.port"
LOG_FILE="$SCRIPT_DIR/.sid.log"

find_free_port() {
    local port
    for port in $(shuf -i 8000-9000 -n 20); do
        if ! ss -tuln 2>/dev/null | grep -qE ":${port}\b"; then
            echo "$port"
            return 0
        fi
    done
    echo "8080" # Safe fallback
}

is_running() {
    if [[ -f "$PID_FILE" ]]; then
        local pid=$(cat "$PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
            return 0
        else
            rm -f "$PID_FILE" "$PORT_FILE" # Clean stale PID
            return 1
        fi
    fi
    return 1
}

cmd_start() {
    if is_running; then
        echo "✅ Already running on http://localhost:$(cat "$PORT_FILE") (PID: $(cat "$PID_FILE"))"
        return 0
    fi

    local port=$(find_free_port)
    echo "🚀 Starting server on dynamic port $port..."
    
    # Start detached in background. Only this specific python process is affected.
    nohup python3 -m http.server "$port" --directory "$SCRIPT_DIR" > "$LOG_FILE" 2>&1 &
    local pid=$!
    
    echo "$pid" > "$PID_FILE"
    echo "$port" > "$PORT_FILE"
    
    sleep 1
    if kill -0 "$pid" 2>/dev/null; then
        echo "✅ Success! Open: http://localhost:$port"
    else
        echo "❌ Failed. Check .sid.log"
        rm -f "$PID_FILE" "$PORT_FILE"
    fi
}

cmd_stop() {
    if ! is_running; then
        echo "⚠️ Server is not running."
        return 0
    fi
    local pid=$(cat "$PID_FILE")
    echo "🛑 Stopping server (PID: $pid)..."
    kill "$pid" 2>/dev/null || true
    rm -f "$PID_FILE" "$PORT_FILE"
    echo "✅ Server stopped."
}

cmd_status() {
    if is_running; then
        echo "✅ RUNNING on http://localhost:$(cat "$PORT_FILE") (PID: $(cat "$PID_FILE"))"
    else
        echo "⚠️ STOPPED"
    fi
}

cmd_logs() {
    if [[ -f "$LOG_FILE" ]]; then
        tail -f "$LOG_FILE"
    else
        echo "⚠️ No logs yet."
    fi
}

case "${1:-status}" in
    start)   cmd_start ;;
    stop)    cmd_stop ;;
    restart) cmd_stop; sleep 1; cmd_start ;;
    status)  cmd_status ;;
    logs)    cmd_logs ;;
    *)       echo "Usage: ./sid {start|stop|restart|status|logs}" ;;
esac
